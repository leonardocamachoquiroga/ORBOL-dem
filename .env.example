# Optional OpenAI Chat Completions endpoint. Never commit a real API key.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=replace-with-your-openai-api-key
LLM_MODEL=gpt-4.1-mini

# Set to 1 for a deterministic local presentation without external API requests.
OLBOL_LOCAL_ADVISOR=1
